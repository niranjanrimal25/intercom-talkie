    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.8,18 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0" />
    <!-- Phone B (top-right) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.8,6 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0" />
